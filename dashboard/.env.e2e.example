# Example environment variables for authenticated Playwright E2E tests
# Copy to .env.e2e (ignored) and fill with real, non-production credentials.

# =============================================================================
# Test User Credentials (Required for all E2E tests)
# =============================================================================
TEST_USER_EMAIL=test.user@example.com
TEST_USER_PASSWORD=change_me_local

# =============================================================================
# Supabase Configuration (Required for all E2E tests)
# =============================================================================
# Full Supabase project URL (ends with .supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co
# Anonymous public API key for the project
SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# Backend URLs (Optional - defaults to localhost)
# =============================================================================
# Document processor backend URL
BACKEND_URL=http://localhost:8090
# Frontend URL
BASE_URL=http://localhost:5173

# =============================================================================
# Azure Service Principal (Required for provisioning E2E tests)
# =============================================================================
# These credentials are used to provision Azure OpenAI instances for enterprise orgs.
# Create a Service Principal with Contributor role on your Azure subscription:
#   az ad sp create-for-rbac --name "fetchtext-e2e-tests" --role Contributor \
#     --scopes /subscriptions/{subscription-id}/resourceGroups/{resource-group}

# Azure AD Tenant ID (Directory ID)
AZURE_TENANT_ID=your-tenant-id

# Service Principal Application (Client) ID
AZURE_CLIENT_ID=your-client-id

# Service Principal Client Secret (Password)
AZURE_CLIENT_SECRET=your-client-secret

# Azure Subscription ID
AZURE_SUBSCRIPTION_ID=your-subscription-id

# Resource group for customer Azure OpenAI instances
AZURE_CUSTOMER_RESOURCE_GROUP=rg-fetchtext-customers-eastus

# Azure region for customer instances
AZURE_CUSTOMER_LOCATION=eastus

# =============================================================================
# Azure OpenAI (Required for AI-powered document processing tests)
# =============================================================================
# API Key for Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-openai-api-key

# Azure OpenAI endpoint URL
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Deployment name for your model
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# API version
AZURE_OPENAI_API_VERSION=2024-02-15-preview
