{
  "name": "fetchtext-admin",
  "private": false,
  "version": "1.4.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11 <21",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview --host localhost --port 5173",
    "clean": "bash ./scripts/clean.sh",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "test": "npx vitest --environment jsdom",
    "test:watch": "npx vitest --environment jsdom --watch",
    "test:coverage": "npx vitest --environment jsdom --run --coverage",
    "test:ui": "npx vitest --environment jsdom --ui",
    "test:auth": "npx vitest --environment jsdom --run src/__tests__/auth-compliance.test.ts",
    "check:auth": "node scripts/check-auth-compliance.js",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test tests/e2e/document-upload-authenticated.pw.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:integration": "playwright test --config=playwright-integration.config.ts",
    "test:integration:ui": "playwright test --config=playwright-integration.config.ts --ui",
    "test:production": "playwright test --config=playwright.production.config.ts",
    "test:production:headed": "playwright test --config=playwright.production.config.ts --headed",
    "test:production:debug": "playwright test --config=playwright.production.config.ts --debug",
    "test:production:pdf": "playwright test --config=playwright.production.config.ts tests/e2e/production/pdf-upload-production.pw.spec.ts",
    "debug": "./scripts/debug.sh",
    "debug:chrome": "./scripts/debug.sh chrome",
    "debug:edge": "./scripts/debug.sh edge",
    "debug:firefox": "./scripts/debug.sh firefox",
    "debug:test": "./scripts/debug.sh test",
    "debug:attach": "./scripts/debug.sh attach",
    "dev:debug": "vite --debug --force",
    "dev:inspect": "node --inspect-brk ./node_modules/.bin/vite"
  },
