# Production Environment Variables for FetchText
# Copy to .env.production and configure for your deployment
#
# IMPORTANT: These must be set at BUILD TIME for Vite to embed them
# Set these in your CI/CD environment (Vercel, Netlify, etc.)

# =============================================================================
# REQUIRED - Application will not work without these
# =============================================================================

# Supabase Configuration (Production instance)
# Get these from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key

# Document Processor Backend URL
# CRITICAL: This must point to your deployed document processor service
# DO NOT use localhost - this will be embedded in the production build
# Get from: Azure Portal → Container App → Overview → Application URL
VITE_DOCUMENT_PROCESSOR_URL=https://your-container-app.azurecontainerapps.io

# =============================================================================
# OPTIONAL - Features will be disabled if not set
# =============================================================================

# N8N Workflow Automation (for email delivery)
# Set this if you have N8N deployed for production
# Get from: Azure Portal → Container App → Overview → Application URL
VITE_N8N_URL=https://your-n8n-container-app.azurecontainerapps.io

# Application URL (used for email links)
# Falls back to window.location.origin if not set
VITE_APP_URL=https://fetchtext.io

# SendGrid Email Configuration
VITE_SENDGRID_API_KEY=your-sendgrid-api-key
VITE_SENDGRID_FROM_EMAIL=noreply@fetchtext.io
VITE_SENDGRID_FROM_NAME=FetchText
VITE_SENDGRID_REPLY_TO=support@fetchtext.io

# PostHog Analytics
VITE_POSTHOG_KEY=your-posthog-key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# For Vercel:
#   - Set these in Project Settings > Environment Variables
#   - They will be injected at build time
#
# For Netlify:
#   - Set these in Site Settings > Environment Variables
#   - They will be injected at build time
#
# For Docker:
#   - Pass as build args or use multi-stage build with env injection
#
# IMPORTANT: After changing these, you MUST rebuild and redeploy
# Environment variables are embedded at build time, not runtime!
