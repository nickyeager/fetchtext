# Example environment variables for authenticated Playwright E2E tests
# Copy to .env.e2e (ignored) and fill with real, non-production credentials.

TEST_USER_EMAIL=test.user@example.com
TEST_USER_PASSWORD=change_me_local
# Full Supabase project URL (ends with .supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co
# Anonymous public API key for the project
SUPABASE_ANON_KEY=your-anon-key
