# Production E2E Test Environment Variables
# Copy to .env.e2e.production and fill in values

# Production test account credentials
PROD_TEST_USER_EMAIL=your-test-account@example.com
PROD_TEST_USER_PASSWORD=your-password-here

# Production backend URL (document processor Container App)
PROD_BACKEND_URL=https://your-container-app.azurecontainerapps.io

# Optional: Production Supabase details (for direct API testing)
SUPABASE_PROD_URL=https://your-project.supabase.co
SUPABASE_PROD_ANON_KEY=your-anon-key
