{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Starts the Vite dev server in the dashboard folder
            "type": "node-terminal",
            "request": "launch",
            "name": "Run Vite (pnpm dev)",
            "command": "pnpm dev",
            "cwd": "${workspaceFolder}/dashboard"
        },
        {
            // Launch Chrome with proper webRoot and Vite source map mappings
            "type": "chrome",
            "request": "launch",
            "name": "Chrome: Vite App",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/dashboard",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack:///*": "${webRoot}/*",
                "webpack:///./~/*": "${webRoot}/node_modules/*",
                "webpack:///./*": "${webRoot}/*",
                "webpack://*": "${webRoot}/*",
                "/./*": "${webRoot}/*",
                "/src/*": "${webRoot}/src/*",
                "/*": "${webRoot}/*",
                "@/*": "${webRoot}/src/*"
            },
            "skipFiles": [
                "${workspaceFolder}/dashboard/node_modules/**/*.js",
                "<node_internals>/**/*.js"
            ]
        },
        {
            // Attach to existing Chrome/Edge instance (for better debugging)
            "type": "chrome",
            "request": "attach",
            "name": "Attach: Chrome",
            "port": 9222,
            "webRoot": "${workspaceFolder}/dashboard",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack:///*": "${webRoot}/*",
                "/./*": "${webRoot}/*",
                "/src/*": "${webRoot}/src/*",
                "/*": "${webRoot}/*",
                "@/*": "${webRoot}/src/*"
            }
        }
    ],
    "compounds": [
        {
            "name": "Dev: Vite + Debug Chrome",
            "configurations": [
                "Run Vite (pnpm dev)",
                "Chrome: Vite App"
            ]
        }
    ]
}