{
  "github.copilot.chat.byok.ollamaEndpoint": "http://localhost:11435",
  "github.copilot.chat.byok.enabled": true,
  "github.copilot.chat.byok.model": "qwen2.5:7b-instruct-q4_K_M",
  "github.copilot.advanced": {
    "debug.overrideEngine": "copilot-chat"
  },
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "plaintext": true,
    "markdown": true
  },
  // Ensure Docker CLI is available in all integrated terminals (zsh on macOS)
  "terminal.integrated.env.osx": {
    "PATH": "/usr/local/bin:/Applications/Docker.app/Contents/Resources/bin:/opt/homebrew/bin:${env:PATH}"
  }
}
