            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Process Immediately": {
      "main": [
        [
          {
            "node": "Process Document with AI",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format Download Only Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Document with AI": {
      "main": [
        [
          {
            "node": "Store Processed Document",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Store Processed Document": {
      "main": [
        [
          {
