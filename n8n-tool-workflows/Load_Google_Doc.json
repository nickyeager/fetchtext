          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": {
      "onError": "continueRegularExecution"
    }
  },
  "versionId": "google-doc-loader-v1",
  "meta": {
    "templateId": "google-docs-loader",
    "templateCredsSetupCompleted": false,
    "instanceId": "google-doc-processing-workflow"
  },
  "id": "GoogleDocLoader2024",
  "tags": ["google-docs", "document-processing", "ai-enhancement"],
  "staticData": {}
}